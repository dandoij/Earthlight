   },
   "id": {
    "maxLength": 100,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "title": "Id",
    "type": "string"
   },
   "kind": {
    "anyOf": [
     {
      "$ref": "#/$defs/VantageKind"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Set for vantage points only: what kind of object it is."
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "title": "Name",
    "type": "string"
   },
