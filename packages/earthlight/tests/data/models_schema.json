{
 "EarthSnapshot": {
  "$defs": {
   "HistoryEvent": {
    "additionalProperties": false,
    "description": "Something that happened at a point in time.",
    "properties": {
     "category": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Category",
      "type": "string"
     },
     "id": {
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
     },
     "importance": {
      "maximum": 5,
      "minimum": 1,
      "title": "Importance",
      "type": "integer"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "region": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Region",
      "type": "string"
     },
     "source": {
      "maxLength": 500,
      "pattern": "^https?://\\S+$",
      "title": "Source",
      "type": "string"
     },
     "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
     },
     "wikipedia": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Wikipedia"
     },
     "year": {
      "title": "Year",
      "type": "number"
     },
     "year_uncertainty": {
      "default": 0.0,
      "description": "Plus or minus, in years.",
      "minimum": 0,
      "title": "Year Uncertainty",
      "type": "number"
     }
    },
    "required": [
     "id",
     "name",
     "category",
     "region",
     "summary",
     "importance",
     "source",
     "year"
    ],
    "title": "HistoryEvent",
    "type": "object"
   },
   "HistoryPeriod": {
    "additionalProperties": false,
    "description": "An age, era, or dynasty that lasted for a span of time.",
    "properties": {
     "category": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Category",
      "type": "string"
     },
     "end": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "When the period ended. Missing exactly when it is ongoing.",
      "title": "End"
     },
     "id": {
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
     },
     "importance": {
      "maximum": 5,
      "minimum": 1,
      "title": "Importance",
      "type": "integer"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "ongoing": {
      "default": false,
      "description": "True for a period that has not ended yet, such as the Holocene.",
      "title": "Ongoing",
      "type": "boolean"
     },
     "region": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Region",
      "type": "string"
     },
     "source": {
      "maxLength": 500,
      "pattern": "^https?://\\S+$",
      "title": "Source",
      "type": "string"
     },
     "start": {
      "title": "Start",
      "type": "number"
     },
     "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
     },
     "wikipedia": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Wikipedia"
     }
    },
    "required": [
     "id",
     "name",
     "category",
     "region",
     "summary",
     "importance",
     "source",
     "start"
    ],
    "title": "HistoryPeriod",
    "type": "object"
   },
   "LandmarkStatus": {
    "description": "Where a landmark stood in its life during the viewed span (never built yet is omitted).",
    "enum": [
     "under_construction",
     "standing",
     "destroyed"
    ],
    "title": "LandmarkStatus",
    "type": "string"
   },
   "LookbackRange": {
    "additionalProperties": false,
    "description": "A lookback in years as a low, best, and high estimate (``minimum <= best <= maximum``).",
    "properties": {
     "best": {
      "title": "Best",
      "type": "number"
     },
     "maximum": {
      "title": "Maximum",
      "type": "number"
     },
     "minimum": {
      "title": "Minimum",
      "type": "number"
     }
    },
    "required": [
     "minimum",
     "best",
     "maximum"
    ],
    "title": "LookbackRange",
    "type": "object"
   },
   "MomentRange": {
    "additionalProperties": false,
    "description": "A span of moments as ``earliest <= best <= latest`` (decimal years).",
    "properties": {
     "best": {
      "title": "Best",
      "type": "number"
     },
     "earliest": {
      "title": "Earliest",
      "type": "number"
     },
     "latest": {
      "title": "Latest",
      "type": "number"
     }
    },
    "required": [
     "earliest",
     "best",
     "latest"
    ],
    "title": "MomentRange",
    "type": "object"
   },
   "PopulationEstimate": {
    "additionalProperties": false,
    "description": "A world population estimate.",
    "properties": {
     "people": {
      "minimum": 0,
      "title": "People",
      "type": "integer"
     },
     "source": {
      "anyOf": [
       {
        "maxLength": 500,
        "pattern": "^https?://\\S+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source"
     },
     "year": {
      "title": "Year",
      "type": "number"
     }
    },
    "required": [
     "year",
     "people"
    ],
    "title": "PopulationEstimate",
    "type": "object"
   },
   "SnapshotLandmark": {
    "additionalProperties": false,
    "description": "A landmark together with its status during the viewed span.",
    "properties": {
     "built_end": {
      "title": "Built End",
      "type": "number"
     },
     "built_start": {
      "title": "Built Start",
      "type": "number"
     },
     "category": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Category",
      "type": "string"
     },
     "destroyed": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Destroyed"
     },
     "id": {
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
     },
     "importance": {
      "maximum": 5,
      "minimum": 1,
      "title": "Importance",
      "type": "integer"
     },
     "lat": {
      "maximum": 90,
      "minimum": -90,
      "title": "Lat",
      "type": "number"
     },
     "lon": {
      "maximum": 180,
      "minimum": -180,
      "title": "Lon",
      "type": "number"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "region": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Region",
      "type": "string"
     },
     "source": {
      "maxLength": 500,
      "pattern": "^https?://\\S+$",
      "title": "Source",
      "type": "string"
     },
     "status": {
      "$ref": "#/$defs/LandmarkStatus"
     },
     "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
     },
     "wikipedia": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Wikipedia"
     }
    },
    "required": [
     "id",
     "name",
     "category",
     "region",
     "summary",
     "importance",
     "source",
     "built_start",
     "built_end",
     "lat",
     "lon",
     "status"
    ],
    "title": "SnapshotLandmark",
    "type": "object"
   },
   "VantageKind": {
    "description": "What a vantage point is. The values are part of the JSON contract.",
    "enum": [
     "planet",
     "spacecraft",
     "zone",
     "star",
     "exoplanet",
     "star_cluster",
     "galaxy",
     "galaxy_cluster",
     "quasar",
     "cosmic_background"
    ],
    "title": "VantageKind",
    "type": "string"
   },
   "VantagePoint": {
    "additionalProperties": false,
    "description": "A place you can stand on and look back at Earth from.",
    "properties": {
     "constellation": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Full constellation name, for objects with a sky position.",
      "title": "Constellation"
     },
     "dec_deg": {
      "anyOf": [
       {
        "maximum": 90,
        "minimum": -90,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Declination in degrees (equatorial, about J2000). Set with ra_deg.",
      "title": "Dec Deg"
     },
     "facts": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "description": "Extra facts shown on the object's page.",
      "title": "Facts",
      "type": "object"
     },
     "fame": {
      "default": 0,
      "description": "How well known the object is: 0 means not curated, 5 means a household name.",
      "maximum": 5,
      "minimum": 0,
      "title": "Fame",
      "type": "integer"
     },
     "host_id": {
      "anyOf": [
       {
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "For an exoplanet, the id of its host star's vantage point.",
      "title": "Host Id"
     },
     "id": {
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
     },
     "kind": {
      "$ref": "#/$defs/VantageKind"
     },
     "lookback": {
      "$ref": "#/$defs/LookbackRange",
      "description": "Years of lookback: light from Earth that left this long ago is arriving here."
     },
     "magnitude": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Apparent visual magnitude as seen from Earth (smaller is brighter).",
      "title": "Magnitude"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "ra_deg": {
      "anyOf": [
       {
        "exclusiveMaximum": 360,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Right ascension in degrees (equatorial, about J2000). Set with dec_deg.",
      "title": "Ra Deg"
     },
     "wikipedia": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Wikipedia article title, used to fetch an image.",
      "title": "Wikipedia"
     }
    },
    "required": [
     "id",
     "name",
     "kind",
     "lookback"
    ],
    "title": "VantagePoint",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "description": "The answer to \"what does Earth look like in the light arriving at this place?\".",
  "properties": {
   "earth_exists": {
    "default": true,
    "description": "False when the light is older than Earth itself.",
    "title": "Earth Exists",
    "type": "boolean"
   },
   "event_total": {
    "default": 0,
    "description": "How many events fell in the span (more than are listed).",
    "minimum": 0,
    "title": "Event Total",
    "type": "integer"
   },
   "events": {
    "default": [],
    "items": {
     "$ref": "#/$defs/HistoryEvent"
    },
    "title": "Events",
    "type": "array"
   },
   "landmark_total": {
    "default": 0,
    "description": "How many landmarks were begun by the middle of the span.",
    "minimum": 0,
    "title": "Landmark Total",
    "type": "integer"
   },
   "landmarks": {
    "default": [],
    "items": {
     "$ref": "#/$defs/SnapshotLandmark"
    },
    "title": "Landmarks",
    "type": "array"
   },
   "moments": {
    "$ref": "#/$defs/MomentRange",
    "description": "The span of Earth's history whose light is arriving."
   },
   "moments_label": {
    "description": "The span for people, such as \"1960 CE to 1980 CE\".",
    "maxLength": 200,
    "minLength": 1,
    "title": "Moments Label",
    "type": "string"
   },
   "notes": {
    "default": [],
    "description": "Plain-language remarks, such as a very wide span.",
    "items": {
     "type": "string"
    },
    "title": "Notes",
    "type": "array"
   },
   "period_total": {
    "default": 0,
    "description": "How many periods overlapped the span.",
    "minimum": 0,
    "title": "Period Total",
    "type": "integer"
   },
   "periods": {
    "default": [],
    "items": {
     "$ref": "#/$defs/HistoryPeriod"
    },
    "title": "Periods",
    "type": "array"
   },
   "population": {
    "anyOf": [
     {
      "$ref": "#/$defs/PopulationEstimate"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "vantage_point": {
    "$ref": "#/$defs/VantagePoint"
   },
   "wide_span": {
    "default": false,
    "description": "True when the span of Earth's history is very wide (over 1,000 years).",
    "title": "Wide Span",
    "type": "boolean"
   }
  },
  "required": [
   "vantage_point",
   "moments",
   "moments_label"
  ],
  "title": "EarthSnapshot",
  "type": "object"
 },
 "ExoplanetDetails": {
  "additionalProperties": false,
  "description": "What the NASA Exoplanet Archive says about a planet, beyond where it is.",
  "properties": {
   "controversial": {
    "default": false,
    "description": "True when the archive flags the planet as disputed.",
