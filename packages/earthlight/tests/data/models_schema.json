 "SearchResult": {
  "$defs": {
   "SearchType": {
    "description": "What kind of thing a search result or suggestion points at.",
    "enum": [
     "vantage_point",
     "event",
     "period",
     "landmark"
    ],
    "title": "SearchType",
    "type": "string"
   },
   "VantageKind": {
    "description": "What a vantage point is. The values are part of the JSON contract.",
    "enum": [
     "planet",
     "spacecraft",
     "zone",
     "star",
     "exoplanet",
     "star_cluster",
     "galaxy",
     "galaxy_cluster",
     "quasar",
     "cosmic_background"
    ],
    "title": "VantageKind",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "description": "One hit from a search. Results are ordered best first.",
  "properties": {
   "description": {
    "anyOf": [
     {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "A short line to tell hits apart.",
