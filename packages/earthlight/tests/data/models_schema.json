   },
   "nasa_name": {
    "maxLength": 200,
    "minLength": 1,
    "title": "Nasa Name",
    "type": "string"
   },
   "orbital_period_days": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Orbital Period Days"
   },
   "radius_earth": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Radius in Earth radii, when measured.",
    "title": "Radius Earth"
   }
  },
  "required": [
   "nasa_name",
   "host_name"
  ],
  "title": "ExoplanetDetails",
  "type": "object"
 },
